rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'bigguy@admin.com';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin';
    }

    match /bigguys/{docId} {
      allow read: if (signedIn() && (docId == 'public' || docId == 'attendance')) || admin();
      allow write: if admin()
        || (signedIn()
            && request.auth.token.firebase.sign_in_provider == 'anonymous'
            && docId == 'attendance');
    }
  }
}
